# Application execution contexts and cross-task handoffs.
direction: right

title: "Control task and ROS loop — execution contexts" {
  shape: text
}

control: "Control task — core 0\n1 ms cadence:\nRcReceiver::service()\n\nEvery 20 ms:\nRelayFeatureController::service()\nservice indicators + copy snapshot" {
  shape: rectangle
  style.fill: "#e8f5e9"
}

rosloop: "Arduino loop — core 1\nDrain up to 16 queued logs\nMicroRosBridge::service()\nStore agent availability\nReceive latest snapshot\nPublish telemetry + status" {
  shape: rectangle
  style.fill: "#ede7f6"
}

snapshot: "Length-one snapshot queue\nzero-wait overwrite" {
  shape: cylinder
  style.fill: "#e0f2f1"
}

logs: "Bounded log queue\nzero-wait producer" {
  shape: cylinder
  style.fill: "#f3e5f5"
}

agent: "Agent availability\nrelease/acquire atomic" {
  shape: cylinder
  style.fill: "#fff3e0"
}

control -> snapshot: "publishes newest copied state"
snapshot -> rosloop: "non-blocking receive"
control -> logs: "enqueues events"
logs -> rosloop: "bounded drain; Serial output"
rosloop -> agent: "stores after bridge service"
agent -> control: "loads before feature evaluation"
