# Module ownership and dependency view.
direction: right

title: "Firmware Modules — ownership and dependencies" {
  shape: text
}

app: "app.cpp + app.h\nWiring, boot order,\ncontrol task + ROS loop" {
  shape: rectangle
  style.fill: "#e3f2fd"
}

relayboard: "RelayBoard\nTCA9554 + DIN + LED + buzzer\nsingle hardware facade" {
  shape: rectangle
  style.fill: "#fff3e0"
}

receiver: "RcReceiver + rc_config.h\ni-BUS + channel table\nreceiver state machine" {
  shape: rectangle
  style.fill: "#e8f5e9"
}

controller: "RelayFeatureController\nBindings + permission\nONLY runtime relay writer" {
  shape: rectangle
  style.fill: "#fce4ec"
  style.stroke-width: 3
}

bridge: "MicroRosBridge\nEthernet + agent state + publishers\nPUBLISH-ONLY, no subscriptions" {
  shape: rectangle
  style.fill: "#ede7f6"
}

exchange: "State exchange\nLength-one snapshot queue\n+ agent atomic" {
  shape: rectangle
  style.fill: "#e0f2f1"
}

diagnostics: "Diagnostics\nBounded log queue\n+ dropped counter" {
  shape: rectangle
  style.fill: "#f3e5f5"
}

ibus: "lib/IBusBM\nvendored (3.x timer fix)" {
  shape: cylinder
  style.fill: "#f5f5f5"
}

# Dependencies and handoffs
app -> relayboard: "owns"
app -> receiver: "owns"
app -> controller: "owns"
app -> bridge: "owns"
app -> exchange: "initializes + coordinates handoffs"
app -> diagnostics: "initializes / drains"
controller -> relayboard: "WRITES\nonly path" {
  style.stroke-width: 2
}
controller -> receiver: "reads state"
app -> exchange: "publishes snapshot;\nstores/loads agent state"
controller -> diagnostics: "zero-wait log enqueue"
relayboard -> diagnostics: "zero-wait log enqueue"
receiver -> diagnostics: "zero-wait log enqueue"
ibus -> receiver: "uses"

rule: "RULE: bridge never reads live receiver or board state" {
  shape: text
  style.font-color: "#b71c1c"
}
